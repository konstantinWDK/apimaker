import {
  Controller, Get, Post, Put, Delete, Body, Param, Query,
  UseGuards, HttpException, HttpStatus, Injectable, NestMiddleware,
} from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository, FindManyOptions } from 'typeorm';
import { ApiTags, ApiOperation, ApiBearerAuth, ApiHeader, ApiQuery } from '@nestjs/swagger';
import * as jwt from 'jsonwebtoken';

// ─── Configuration ─────────────────────────────────────────────
const AUTH_METHOD = process.env.AUTH_METHOD || '{{ auth_method }}';
const API_KEY = process.env.API_KEY || '{{ api_key }}';
const JWT_SECRET = process.env.JWT_SECRET || '{{ jwt_secret }}';
const RATE_LIMIT_MAX = parseInt(process.env.RATE_LIMIT_MAX || '{{ rate_limit or 0 }}', 10);

// ─── Auth Guard ────────────────────────────────────────────────
@Injectable()
export class AuthGuard implements NestMiddleware {
  use(req: any, res: any, next: () => void) {
    if (AUTH_METHOD === 'none') return next();

    if (AUTH_METHOD === 'apikey') {
      const key = req.headers['x-api-key'];
      if (!key || key !== API_KEY) {
        return res.status(401).json({ error: 'Unauthorized', detail: 'Invalid or missing API Key' });
      }
      return next();
    }

    if (AUTH_METHOD === 'jwt') {
      const authHeader = req.headers['authorization'];
      const token = authHeader && authHeader.split(' ')[1];
      if (!token) {
        return res.status(401).json({ error: 'Unauthorized', detail: 'Missing Bearer Token' });
      }
      try {
        req.user = jwt.verify(token, JWT_SECRET);
        next();
      } catch {
        return res.status(401).json({ error: 'Unauthorized', detail: 'Invalid or expired JWT' });
      }
    }
    next();
  }
}

// ─── DTOs ──────────────────────────────────────────────────────
{% for ds in datasets %}
{% set model_name = ds.name | capitalize | replace(" ", "") %}
export class Create{{ model_name }}Dto {
{% for field in ds.fields %}
  {{ field.name }}{{ "?" if not field.required else "" }}: {{ "string" if field.type in ["string", "datetime", "email"] else "number" if field.type in ["integer", "float"] else "boolean" }};
{% endfor %}
}

export class Update{{ model_name }}Dto {
{% for field in ds.fields %}
  {{ field.name }}?: {{ "string" if field.type in ["string", "datetime", "email"] else "number" if field.type in ["integer", "float"] else "boolean" }};
{% endfor %}
}

{% endfor %}

// ─── Controller ────────────────────────────────────────────────
{% for ds in datasets %}
{% set model_name = ds.name | capitalize | replace(" ", "") %}
@ApiTags('{{ model_name }}')
@Controller()
export class {{ model_name }}Controller {
  constructor(
    @InjectRepository({{ model_name }})
    private readonly repo: Repository<{{ model_name }}>,
  ) {}

  @Get('{{ ds.name | lower | replace(" ", "_") }}')
  @ApiOperation({ summary: 'List all {{ model_name }}' })
  @ApiQuery({ name: 'page', required: false, type: Number })
  @ApiQuery({ name: 'limit', required: false, type: Number })
  @ApiQuery({ name: 'include', required: false, type: String, description: 'Comma-separated relations' })
{% if auth_method == 'jwt' %}
  @ApiBearerAuth()
{% elif auth_method == 'apikey' %}
  @ApiHeader({ name: 'X-API-Key', required: true })
{% endif %}
  async findAll(
    @Query('page') page?: number,
    @Query('limit') limit?: number,
    @Query('include') include?: string,
    @Query() filters?: any,
  ) {
    const pg = Math.max(page || 1, 1);
    const lim = Math.min(limit || 100, 1000);
    const where: any = {};
    const filterable = [{% for f in ds.fields %}'{{ f.name }}'{% if not loop.last %}, {% endif %}{% endfor %}];
    for (const key of Object.keys(filters)) {
      if (filterable.includes(key) && !['page', 'limit', 'include'].includes(key)) {
        where[key] = filters[key];
      }
    }
    const relations: string[] = [];
    if (include) {
      const requested = include.split(',').map(s => s.trim());
      {% for field in ds.fields %}
      {% if field.references %}
      if (requested.includes('{{ field.references.dataset_name | lower }}')) {
        relations.push('{{ field.references.dataset_name | lower }}');
      }
      {% endif %}
      {% endfor %}
      {% for ref in ds.referenced_by %}
      if (requested.includes('{{ ref.dataset_name | lower }}')) {
        relations.push('{{ ref.dataset_name | lower | replace(" ", "_") }}Items');
      }
      {% endfor %}
    }
    const [data, total] = await this.repo.findAndCount({
      where, skip: (pg - 1) * lim, take: lim, relations,
    });
    return { data, total, page: pg, pages: Math.ceil(total / lim) };
  }

  @Get('{{ ds.name | lower | replace(" ", "_") }}/:id')
  @ApiOperation({ summary: 'Get {{ model_name }} by ID' })
{% if auth_method == 'jwt' %}
  @ApiBearerAuth()
{% elif auth_method == 'apikey' %}
  @ApiHeader({ name: 'X-API-Key', required: true })
{% endif %}
  async findOne(@Param('id') id: number) {
    const item = await this.repo.findOne({ where: { id } });
    if (!item) throw new HttpException({ error: 'Not Found', detail: '{{ model_name }} not found' }, HttpStatus.NOT_FOUND);
    return item;
  }

  @Post('{{ ds.name | lower | replace(" ", "_") }}')
  @ApiOperation({ summary: 'Create {{ model_name }}' })
{% if auth_method == 'jwt' %}
  @ApiBearerAuth()
{% elif auth_method == 'apikey' %}
  @ApiHeader({ name: 'X-API-Key', required: true })
{% endif %}
  async create(@Body() data: Create{{ model_name }}Dto) {
    return this.repo.save(data as any);
  }

  @Put('{{ ds.name | lower | replace(" ", "_") }}/:id')
  @ApiOperation({ summary: 'Update {{ model_name }}' })
{% if auth_method == 'jwt' %}
  @ApiBearerAuth()
{% elif auth_method == 'apikey' %}
  @ApiHeader({ name: 'X-API-Key', required: true })
{% endif %}
  async update(@Param('id') id: number, @Body() data: Update{{ model_name }}Dto) {
    const item = await this.repo.findOne({ where: { id } });
    if (!item) throw new HttpException({ error: 'Not Found', detail: '{{ model_name }} not found' }, HttpStatus.NOT_FOUND);
    await this.repo.update(id, data as any);
    return this.repo.findOne({ where: { id } });
  }

  @Delete('{{ ds.name | lower | replace(" ", "_") }}/:id')
  @ApiOperation({ summary: 'Delete {{ model_name }}' })
{% if auth_method == 'jwt' %}
  @ApiBearerAuth()
{% elif auth_method == 'apikey' %}
  @ApiHeader({ name: 'X-API-Key', required: true })
{% endif %}
  async delete(@Param('id') id: number) {
    const item = await this.repo.findOne({ where: { id } });
    if (!item) throw new HttpException({ error: 'Not Found', detail: '{{ model_name }} not found' }, HttpStatus.NOT_FOUND);
    await this.repo.delete(id);
    return null;
  }
}

{% endfor %}

// ─── Main App Controller ──────────────────────────────────────
@Controller()
export class AppController {
  @Get('health')
  @ApiOperation({ summary: 'Health check' })
  getHealth() {
    return { status: 'ok', stack: 'nestjs', uptime: process.uptime() };
  }
}

// ─── Auth Middleware Registration ──────────────────────────────
export function configureAuthMiddleware(consumer: any) {
  if (AUTH_METHOD !== 'none') {
    consumer.apply(AuthGuard).forRoutes('*');
  }
}

import { Controller, Get, Post, Body, Param, Put, Delete, UseGuards, Request } from '@nestjs/common';
import { ApiTags, ApiOperation, ApiBearerAuth, ApiHeader } from '@nestjs/swagger';

@Controller()
export class AppController {
  private db: any = {};

  constructor() {
    // In a real scenario, we would use services and TypeORM
    // For this generated bundle, we use a simple shared store initialized by main.ts
    this.db = (global as any).apiDatabase || {};
  }

  @Get('health')
  @ApiOperation({ summary: 'Health check' })
  getHealth() {
    return { status: 'ok', stack: 'nestjs' };
  }

  {% for ds in datasets %}
  // --- Resources for {{ ds.name }} ---

  @ApiTags('{{ ds.name }}')
  @Get('{{ ds.name | lower | replace(" ", "_") }}')
  @ApiOperation({ summary: 'List all {{ ds.name }}' })
  list{{ ds.name | capitalize | replace(" ", "") }}() {
    return this.db["{{ ds.name }}"] || [];
  }

  @ApiTags('{{ ds.name }}')
  @Post('{{ ds.name | lower | replace(" ", "_") }}')
  @ApiOperation({ summary: 'Create {{ ds.name }}' })
  create{{ ds.name | capitalize | replace(" ", "") }}(@Body() data: any) {
    const newItem = { id: Date.now(), ...data, created_at: new Date() };
    if (!this.db["{{ ds.name }}"]) this.db["{{ ds.name }}"] = [];
    this.db["{{ ds.name }}"].push(newItem);
    return newItem;
  }
  {% endfor %}
}

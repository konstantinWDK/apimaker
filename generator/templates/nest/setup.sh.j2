#!/bin/bash

# API Maker Installer Script
echo "🚀 Bienvenido al instalador de {{ project_name }}"
echo "==============================================="

# Check requirements
if ! [ -x "$(command -v docker)" ]; then
  echo "❌ Error: Docker no está instalado." >&2
  exit 1
fi

if ! [ -x "$(command -v docker-compose)" ]; then
  echo "⚠️  Aviso: docker-compose no está instalado directamente, intentando con 'docker compose'..."
fi

# Ask for configuration
read -p "🔹 ¿En qué puerto quieres correr la API? [8000]: " API_PORT
API_PORT=${API_PORT:-8000}

read -p "🔹 ¿Quieres usar una base de datos PostgreSQL en Docker? [y/N]: " USE_DB
USE_DB=${USE_DB:-n}

# Create .env
echo "📝 Generando archivo .env..."
cat <<EOF > .env
API_PORT=$API_PORT
EOF

if [[ $USE_DB =~ ^[Yy]$ ]]; then
  echo "DATABASE_URL=postgresql://postgres:postgres@db:5432/api_db" >> .env
  echo "DB_USER=postgres" >> .env
  echo "DB_PASSWORD=postgres" >> .env
  echo "DB_NAME=api_db" >> .env
  echo "DB_PORT=5432" >> .env
else
  echo "DATABASE_URL=sqlite:///./data.db" >> .env
fi

{% if auth_method != 'none' %}
read -p "🔹 Configuración de seguridad ({{ auth_method }}): " SEC_VAL
if [ "{{ auth_method }}" == "apikey" ]; then
  echo "API_KEY=$SEC_VAL" >> .env
else
  echo "JWT_SECRET=$SEC_VAL" >> .env
fi
{% endif %}

echo "✅ Configuración guardada en .env"

# Run with docker
echo "🐳 Levantando contenedores..."
docker compose up -d --build

echo "==============================================="
echo "✨ ¡Listo! Tu API está corriendo en http://localhost:$API_PORT"
echo "📚 Documentación: http://localhost:$API_PORT/docs"
echo "==============================================="

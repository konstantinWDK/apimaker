# Server configuration
PORT=8000

# Database
# SQLite: sqlite:./data.db
# Postgres: postgres://user:pass@host:5432/db
DATABASE_URL=sqlite:./data.db

# Security
# none | apikey | jwt
AUTH_METHOD={{ auth_method }}

# Required if AUTH_METHOD=apikey
API_KEY={{ api_key }}

# Required if AUTH_METHOD=jwt
JWT_SECRET={{ jwt_secret }}

# Rate Limiting (peticiones por minuto)
RATE_LIMIT={{ rate_limit or 0 }}

# CORS allowed origins (comma-separated, * for all)
CORS_ORIGINS=*

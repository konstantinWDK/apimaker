const express = require('express');
const bodyParser = require('body-parser');
const jwt = require('jsonwebtoken');
const fs = require('fs');
const path = require('path');
const swaggerUi = require('swagger-ui-express');

const app = express();
app.use(bodyParser.json());

// --- Configuration ---
const PORT = process.env.PORT || 8000;
const AUTH_METHOD = "{{ auth_method }}";
const API_KEY = process.env.API_KEY || "{{ api_key }}";
const JWT_SECRET = process.env.JWT_SECRET || "{{ jwt_secret }}";

// --- In-memory Data (Seed support) ---
let db = {};
const dataPath = path.join(__dirname, 'data.json');

if (fs.existsSync(dataPath)) {
  try {
    db = JSON.parse(fs.readFileSync(dataPath, 'utf8'));
    console.log("✅ Database seeded with data.json");
  } catch (e) {
    console.error("❌ Error loading data.json", e);
    db = {};
  }
}

// Ensure each dataset has at least an empty array
{% for ds in datasets %}
if (!db["{{ ds.name }}"]) db["{{ ds.name }}"] = [];
{% endfor %}

// --- Middleware: Auth ---
const verifyAuth = (req, res, next) => {
  if (AUTH_METHOD === 'none') return next();

  if (AUTH_METHOD === 'apikey') {
    const key = req.headers['x-api-key'];
    if (key !== API_KEY) return res.status(401).json({ error: 'Invalid API Key' });
    return next();
  }

  if (AUTH_METHOD === 'jwt') {
    const authHeader = req.headers['authorization'];
    const token = authHeader && authHeader.split(' ')[1];
    if (!token) return res.status(401).json({ error: 'Missing token' });

    jwt.verify(token, JWT_SECRET, (err, user) => {
      if (err) return res.status(403).json({ error: 'Invalid token' });
      req.user = user;
      next();
    });
    return;
  }
  next();
};

// --- Routes & Documentation Setup ---
const swaggerDoc = {
  openapi: '3.0.0',
  info: { title: '{{ project_name }}', version: '1.0.0', description: '{{ project_description }}' },
  paths: {},
  components: {
    securitySchemes: {
      ApiKeyAuth: { type: 'apiKey', in: 'header', name: 'X-API-Key' },
      BearerAuth: { type: 'http', scheme: 'bearer', bearerFormat: 'JWT' }
    }
  }
};

{% for ds in datasets %}
const {{ ds.name | lower | replace(" ", "_") }}Router = express.Router();

// --- Resource: {{ ds.name }} ---
{{ ds.name | lower | replace(" ", "_") }}Router.get('/', verifyAuth, (req, res) => {
  res.json(db["{{ ds.name }}"]);
});

{{ ds.name | lower | replace(" ", "_") }}Router.post('/', verifyAuth, (req, res) => {
  const newItem = { id: db["{{ ds.name }}"].length + 1, ...req.body, created_at: new Date() };
  db["{{ ds.name }}"].push(newItem);
  res.status(201).json(newItem);
});

// Registrar rutas para este recurso
{% for ep in endpoints %}
  {% if ep.target_dataset_id == ds.id %}
    app.use('{{ ep.path }}', {{ ds.name | lower | replace(" ", "_") }}Router);
  {% endif %}
{% endfor %}
{% endfor %}

// --- Global Routes ---
app.get('/health', (req, res) => res.json({ status: 'ok', stack: 'express' }));

// --- Documentation ---
app.use('/docs', swaggerUi.serve, swaggerUi.setup(swaggerDoc));

app.listen(PORT, () => {
  console.log(`🚀 {{ project_name }} running on http://localhost:${PORT}`);
  console.log(`📚 Documentation available on http://localhost:${PORT}/docs`);
});

const express = require('express');
const { Sequelize, DataTypes } = require('sequelize');
const jwt = require('jsonwebtoken');
const rateLimit = require('express-rate-limit');
const swaggerUi = require('swagger-ui-express');
const swaggerJsdoc = require('swagger-jsdoc');
const path = require('path');
const fs = require('fs');

// ─── Configuration ───────────────────────────────────────────────
const PORT = process.env.PORT || 8000;
const DATABASE_URL = process.env.DATABASE_URL || 'sqlite:./data.db';
const AUTH_METHOD = process.env.AUTH_METHOD || '{{ auth_method }}';
const API_KEY = process.env.API_KEY || '{{ api_key }}';
const JWT_SECRET = process.env.JWT_SECRET || '{{ jwt_secret }}';
const RATE_LIMIT_WINDOW = parseInt(process.env.RATE_LIMIT_WINDOW || '60000', 10);
const RATE_LIMIT_MAX = parseInt(process.env.RATE_LIMIT_MAX || '{{ rate_limit or 0 }}', 10);

// ─── Database ──────────────────────────────────────────────────
const sequelize = new Sequelize(DATABASE_URL, {
  logging: false,
  dialectOptions: DATABASE_URL.startsWith('sqlite') ? {} : { ssl: false },
});

// ─── Models ────────────────────────────────────────────────────
{% for ds in datasets %}
{% set model_name = ds.name | capitalize | replace(" ", "") %}
const {{ model_name }} = sequelize.define('{{ model_name }}', {
  id: { type: DataTypes.INTEGER, primaryKey: true, autoIncrement: true },
{% for field in ds.fields %}
  {{ field.name }}: {
    type: DataTypes.{{ field.type | upper }},
    allowNull: {{ (not field.required) | js_bool }}{% if field.references %},
    references: {
      model: '{{ field.references.dataset_name | capitalize | replace(" ", "") }}',
      key: '{{ field.references.field_name }}',
    },
    onUpdate: 'CASCADE',
    onDelete: 'SET NULL'{% endif %}
  },
{% endfor %}
  createdAt: { type: DataTypes.DATE, defaultValue: DataTypes.NOW },
  updatedAt: { type: DataTypes.DATE, defaultValue: DataTypes.NOW },
});

{% endfor %}

// ─── Associations (Foreign Keys) ──────────────────────────────
{% for ds in datasets %}
{% for field in ds.fields %}
  {% if field.references %}
const {{ ds.name | capitalize | replace(" ", "") }} = sequelize.models['{{ ds.name | capitalize | replace(" ", "") }}'];
const {{ field.references.dataset_name | capitalize | replace(" ", "") }} = sequelize.models['{{ field.references.dataset_name | capitalize | replace(" ", "") }}'];
if ({{ ds.name | capitalize | replace(" ", "") }} && {{ field.references.dataset_name | capitalize | replace(" ", "") }}) {
  {{ ds.name | capitalize | replace(" ", "") }}.belongsTo({{ field.references.dataset_name | capitalize | replace(" ", "") }}, {
    foreignKey: '{{ field.name }}',
    as: '{{ field.references.dataset_name | lower | replace(" ", "_") }}',
  });
  {{ field.references.dataset_name | capitalize | replace(" ", "") }}.hasMany({{ ds.name | capitalize | replace(" ", "") }}, {
    foreignKey: '{{ field.name }}',
    as: '{{ ds.name | lower | replace(" ", "_") }}_items',
  });
}
  {% endif %}
{% endfor %}
{% endfor %}

// ─── Swagger Setup ─────────────────────────────────────────────
const swaggerSpec = swaggerJsdoc({
  definition: {
    openapi: '3.0.0',
    info: {
      title: '{{ project_name }}',
      version: '1.0.0',
      description: '{{ project_description or "" }}',
    },
    servers: [{ url: `http://localhost:${PORT}` }],
    components: {
      securitySchemes: {
        ApiKeyAuth: { type: 'apiKey', in: 'header', name: 'X-API-Key' },
        BearerAuth: { type: 'http', scheme: 'bearer', bearerFormat: 'JWT' },
      },
    },
  },
  apis: [],
});

// ─── Express App ───────────────────────────────────────────────
const app = express();
app.use(express.json());

// Rate Limiting
if (RATE_LIMIT_MAX > 0) {
  app.use(rateLimit({
    windowMs: RATE_LIMIT_WINDOW,
    max: RATE_LIMIT_MAX,
    message: { error: 'Too many requests', detail: `Rate limit of ${RATE_LIMIT_MAX} per minute exceeded` },
  }));
}

// ─── Auth Middleware ─────────────────────────────────────────────
function verifyAuth(req, res, next) {
  if (AUTH_METHOD === 'none') return next();

  if (AUTH_METHOD === 'apikey') {
    const key = req.headers['x-api-key'];
    if (!key || key !== API_KEY) {
      return res.status(401).json({ error: 'Unauthorized', detail: 'Invalid or missing API Key' });
    }
    return next();
  }

  if (AUTH_METHOD === 'jwt') {
    const authHeader = req.headers['authorization'];
    const token = authHeader && authHeader.split(' ')[1];
    if (!token) {
      return res.status(401).json({ error: 'Unauthorized', detail: 'Missing Bearer Token' });
    }
    try {
      req.user = jwt.verify(token, JWT_SECRET);
      next();
    } catch (err) {
      return res.status(401).json({ error: 'Unauthorized', detail: 'Invalid or expired JWT' });
    }
    return;
  }
  next();
}

// ─── Error Handler ─────────────────────────────────────────────
function errorHandler(err, req, res, next) {
  console.error('[ERROR]', err.message);
  if (err.name === 'SequelizeValidationError') {
    return res.status(400).json({ error: 'Validation Error', detail: err.errors.map(e => e.message).join(', ') });
  }
  if (err.name === 'SequelizeUniqueConstraintError') {
    return res.status(409).json({ error: 'Conflict', detail: 'Resource already exists' });
  }
  res.status(500).json({ error: 'Internal Server Error', detail: err.message || 'Unexpected error' });
}

// ─── CRUD Route Builder ────────────────────────────────────────
function buildCrudRoutes(model, modelName, basePath, operationTypes, opts = {}) {
  const router = express.Router();
  router.use(verifyAuth);

  // Swagger path registration
  swaggerSpec.paths[basePath] = swaggerSpec.paths[basePath] || {};
  swaggerSpec.paths[`${basePath}/{id}`] = swaggerSpec.paths[`${basePath}/{id}`] || {};

  if (operationTypes.includes('list') || operationTypes.includes('custom')) {
    swaggerSpec.paths[basePath].get = {
      summary: `List all ${modelName}`,
      tags: [modelName],
      parameters: [
        { name: 'page', in: 'query', schema: { type: 'integer' }, description: 'Page number (1-based)' },
        { name: 'limit', in: 'query', schema: { type: 'integer' }, description: 'Max records per page' },
        { name: 'include', in: 'query', schema: { type: 'string' }, description: 'Comma-separated relations to include' },
      ],
      responses: { 200: { description: `Paginated ${modelName} list` } },
    };
    router.get('/', async (req, res, next) => {
      try {
        const page = Math.max(parseInt(req.query.page) || 1, 1);
        const limit = Math.min(parseInt(req.query.limit) || 100, 1000);
        const offset = (page - 1) * limit;

        // Dynamic filters from query params matching model fields
        const where = {};
        const filterable = opts.filterableFields || [];
        for (const key of Object.keys(req.query)) {
          if (filterable.includes(key) && !['page', 'limit', 'include'].includes(key)) {
            where[key] = req.query[key];
          }
        }

        // Eager loading via ?include=relation1,relation2
        const include = [];
        if (req.query.include) {
          const requested = req.query.include.split(',').map(s => s.trim());
          for (const name of (opts.forwardIncludes || [])) {
            if (requested.includes(name)) include.push({ association: name });
          }
          for (const name of (opts.reverseIncludes || [])) {
            if (requested.includes(name)) include.push({ association: name });
          }
        }

        const { count, rows } = await model.findAndCountAll({ where, offset, limit, include });
        res.json({ data: rows, total: count, page, pages: Math.ceil(count / limit) });
      } catch (err) { next(err); }
    });
  }
  }

  if (operationTypes.includes('get')) {
    swaggerSpec.paths[`${basePath}/{id}`].get = {
      summary: `Get ${modelName} by ID`,
      tags: [modelName],
      parameters: [{ name: 'id', in: 'path', required: true, schema: { type: 'integer' } }],
      responses: { 200: { description: modelName }, 404: { description: 'Not found' } },
    };
    router.get('/:id', async (req, res, next) => {
      try {
        const item = await model.findByPk(req.params.id);
        if (!item) return res.status(404).json({ error: 'Not Found', detail: `${modelName} not found` });
        res.json(item);
      } catch (err) { next(err); }
    });
  }

  if (operationTypes.includes('create')) {
    swaggerSpec.paths[basePath].post = {
      summary: `Create ${modelName}`,
      tags: [modelName],
      requestBody: { required: true, content: { 'application/json': { schema: { $ref: `#/components/schemas/${modelName}Input` } } } },
      responses: { 201: { description: `Created ${modelName}` } },
    };
    router.post('/', async (req, res, next) => {
      try {
        const item = await model.create(req.body);
        res.status(201).json(item);
      } catch (err) { next(err); }
    });
  }

  if (operationTypes.includes('update')) {
    swaggerSpec.paths[`${basePath}/{id}`].put = {
      summary: `Update ${modelName}`,
      tags: [modelName],
      parameters: [{ name: 'id', in: 'path', required: true, schema: { type: 'integer' } }],
      requestBody: { required: true, content: { 'application/json': { schema: { $ref: `#/components/schemas/${modelName}Input` } } } },
      responses: { 200: { description: `Updated ${modelName}` } },
    };
    router.put('/:id', async (req, res, next) => {
      try {
        const item = await model.findByPk(req.params.id);
        if (!item) return res.status(404).json({ error: 'Not Found', detail: `${modelName} not found` });
        await item.update(req.body);
        res.json(item);
      } catch (err) { next(err); }
    });
  }

  if (operationTypes.includes('delete')) {
    swaggerSpec.paths[`${basePath}/{id}`].delete = {
      summary: `Delete ${modelName}`,
      tags: [modelName],
      parameters: [{ name: 'id', in: 'path', required: true, schema: { type: 'integer' } }],
      responses: { 204: { description: 'Deleted' } },
    };
    router.delete('/:id', async (req, res, next) => {
      try {
        const item = await model.findByPk(req.params.id);
        if (!item) return res.status(404).json({ error: 'Not Found', detail: `${modelName} not found` });
        await item.destroy();
        res.status(204).end();
      } catch (err) { next(err); }
    });
  }

  app.use(basePath, router);
}

// ─── Register Routes per Endpoint ──────────────────────────────
{% for ep in endpoints %}
{% set target_ds = ep.target_dataset %}
{% if target_ds %}
{% set model_name = target_ds.name | capitalize | replace(" ", "") %}
// Endpoint: {{ ep.name }} ({{ ep.operation_type }}) @ {{ ep.path }}
{% if ep.operation_type == "custom" %}
app.{{ ep.method | lower }}('{{ ep.path }}', verifyAuth, async (req, res, next) => {
  try {
    const items = await {{ model_name }}.findAll();
    res.json({ message: 'Custom endpoint', data: items });
  } catch (err) { next(err); }
});
{% else %}
buildCrudRoutes({{ model_name }}, '{{ model_name }}', '{{ ep.path }}', ['{{ ep.operation_type }}'], {
  filterableFields: [{% for f in target_ds.fields %}'{{ f.name }}'{% if not loop.last %}, {% endif %}{% endfor %}],
  forwardIncludes: [{% for field in target_ds.fields %}{% if field.references %}'{{ field.references.dataset_name | lower }}'{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}],
  reverseIncludes: [{% for ref in target_ds.referenced_by %}'{{ ref.dataset_name | lower }}'{% if not loop.last %}, {% endif %}{% endfor %}],
});
{% endif %}
{% endif %}
{% endfor %}

// ─── Health ──────────────────────────────────────────────────
app.get('/health', (req, res) => {
  res.json({ status: 'ok', stack: 'express', uptime: process.uptime() });
});

// ─── Swagger Docs ─────────────────────────────────────────────
// Generate schemas from models for Swagger
{% for ds in datasets %}
{% set model_name = ds.name | capitalize | replace(" ", "") %}
swaggerSpec.components = swaggerSpec.components || {};
swaggerSpec.components.schemas = swaggerSpec.components.schemas || {};
swaggerSpec.components.schemas['{{ model_name }}'] = {
  type: 'object',
  properties: {
    id: { type: 'integer' },
{% for field in ds.fields %}
    {{ field.name }}: { type: '{{ field.type }}'{% if field.description %}, description: '{{ field.description }}'{% endif %} },
{% endfor %}
    createdAt: { type: 'string', format: 'date-time' },
    updatedAt: { type: 'string', format: 'date-time' },
  },
};
swaggerSpec.components.schemas['{{ model_name }}Input'] = {
  type: 'object',
  properties: {
{% for field in ds.fields %}
    {{ field.name }}: { type: '{{ field.type }}'{% if not field.required %}, nullable: true{% endif %} },
{% endfor %}
  },
};
{% endfor %}

app.use('/docs', swaggerUi.serve, swaggerUi.setup(swaggerSpec));
app.get('/openapi.json', (req, res) => res.json(swaggerSpec));

// ─── Error Handler ─────────────────────────────────────────────
app.use(errorHandler);

// ─── Startup ──────────────────────────────────────────────────
async function start() {
  try {
    await sequelize.sync();
    console.log('✅ Database synced');

    const dataPath = path.join(__dirname, 'data.json');
    if (fs.existsSync(dataPath)) {
      const seedData = JSON.parse(fs.readFileSync(dataPath, 'utf8'));
      for (const [modelName, rows] of Object.entries(seedData)) {
        const model = sequelize.models[modelName];
        if (model) {
          const count = await model.count();
          if (count === 0 && rows.length > 0) {
            await model.bulkCreate(rows);
            console.log(`✅ Seeded ${modelName} with ${rows.length} rows`);
          }
        }
      }
    }

    app.listen(PORT, () => {
      console.log(`🚀 {{ project_name }} running on http://localhost:${PORT}`);
      console.log(`📚 Docs: http://localhost:${PORT}/docs`);
    });
  } catch (err) {
    console.error('❌ Startup failed:', err.message);
    process.exit(1);
  }
}

if (require.main === module) {
  start();
}

module.exports = { app, start, sequelize };

# Server configuration
PORT=8000

# Database connection URL
# SQLite: sqlite:///./data.db
# PostgreSQL: postgresql+psycopg2://user:password@host:5432/database
DATABASE_URL=sqlite:///./data.db

# Security Configuration
# auth_method can be: none | apikey | jwt
AUTH_METHOD={{ auth_method }}

# Required if AUTH_METHOD=apikey
API_KEY={{ api_key }}

# Required if AUTH_METHOD=jwt
JWT_SECRET={{ jwt_secret }}

# Rate Limiting (peticiones por minuto)
# 0 para desactivar
RATE_LIMIT={{ rate_limit or 0 }}

    },
    {
      "id": "ep-2",
      "name": "Search pokemon",
      "method": "GET",
      "path": "/pokemon/search",
      "summary": "Filtra por nombre, región o tipo"
    },
    {
      "id": "ep-3",
      "name": "Pokemon detail",
      "method": "GET",
      "path": "/pokemon/{id}",
      "summary": "Obtiene el detalle de un Pokémon"
    },
    {
      "id": "ep-4",
      "name": "Create pokemon",
      "method": "POST",
